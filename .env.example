# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Gemma 4 via the Gemini API (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-31b-it

# --- Real product images/links/prices via Google Shopping (https://serper.dev, optional) ---
SERPER_API_KEY=
# Default shopping country when the user hasn't picked one (ISO code)
SERPER_COUNTRY=ma

# --- Firebase web app config (Project settings > General > Your apps) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Optional: OAuth "Web client" id. Uses Google's own button instead of the Firebase popup
# (needed on networks that block *.firebaseapp.com)
GOOGLE_OAUTH_CLIENT_ID=

# --- Firebase Admin service account JSON (Project settings > Service accounts) ---
FIREBASE_CREDENTIALS=firebase-service-account.json

# Storage backend: "firestore" or "local" (auto: firestore when FIREBASE_CREDENTIALS exists)
MRAYA_STORAGE=
# Allow the "demo login" button when Firebase isn't configured (DEBUG only)
MRAYA_DEV_LOGIN=true

# Comma-separated extra plugin apps (update packages), e.g. mraya_goals
MRAYA_PLUGINS=
